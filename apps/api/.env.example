# ── Setup ──────────────────────────────────────────────────────────
# 1. Copy to .env and set ONE of the two connection strings below.
# 2. Run `pnpm --filter @einv/api db:setup` — it fills in everything marked (generated).
#
# Supabase: Dashboard → your project → Connect → "Session pooler". Paste it and replace [YOUR-PASSWORD].
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Optional: a second Supabase project just for automated tests (otherwise tests share the project above).
TEST_SUPABASE_DB_URL=""
# Local Postgres instead: a superuser connection (used only if SUPABASE_DB_URL is not set).
ADMIN_DATABASE_URL=""

# ── Database ───────────────────────────────────────────────────────
# Runtime connection: role app_runtime (no BYPASSRLS). On Supabase use the pooled URL (port 6543, ?pgbouncer=true&schema=app).
DATABASE_URL=""            # (generated locally)
# Owner connection used only by `prisma migrate`. On Supabase use the direct URL (port 5432, ?schema=app).
DIRECT_URL=""              # (generated locally)
TEST_DATABASE_URL=""       # (generated locally)
TEST_DIRECT_URL=""         # (generated locally)
APP_RUNTIME_PASSWORD=""    # (generated locally)

# ── Secrets (32 random bytes, base64) ──────────────────────────────
SESSION_SECRET=""          # HMAC key for OTP codes and tokens (generated locally)
DATA_ENCRYPTION_KEY=""     # AES-256-GCM key for bank details and 2FA secrets (generated locally)
CRON_SECRET=""             # shared secret for POST /internal/jobs/run (generated locally)

# ── App ────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
WEB_ORIGIN="http://localhost:3000"     # allowed Origin for state-changing requests (comma-separate several)
PUBLIC_APP_URL="http://localhost:3000" # used to build share and invitation links
LOG_LEVEL="info"

# Run the job drain inside the API process (local dev). On Vercel set false and use pg_cron/Vercel Cron.
JOBS_INPROCESS="true"
# Dev only: include OTP codes in API responses so you can sign in without an SMS/email provider.
OTP_DEV_ECHO="true"

# ── Providers ──────────────────────────────────────────────────────
ACCESS_POINT_PROVIDER="mock"   # mock | (real APP adapter, Phase 4)
TAX_ID_REGISTRY="mock"
EMAIL_PROVIDER="console"       # console | resend
SMS_PROVIDER="console"         # console | termii
RESEND_API_KEY=""
EMAIL_FROM="E-Invoice <no-reply@example.com>"
TERMII_API_KEY=""
TERMII_SENDER_ID=""
WHATSAPP_PROVIDER="console"    # console (WhatsApp Business API arrives in Phase 4)

# Payments (E10). "mock" gives a built-in test checkout and is disabled in production.
# For Paystack, set PAYMENT_PROVIDER="paystack" and a secret key (sk_test_… while testing),
# then point the Paystack dashboard webhook at https://<your-domain>/api/v1/webhooks/paystack.
PAYMENT_PROVIDER="mock"        # mock | paystack
PAYSTACK_SECRET_KEY=""
