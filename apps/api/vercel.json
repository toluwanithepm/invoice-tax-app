{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @einv/shared build && pnpm --filter @einv/api build",
  "crons": [{ "path": "/internal/jobs/run", "schedule": "* * * * *" }]
}
