// Data model. Every tenant-owned table carries workspace_id and is protected by Postgres RLS
// (see migrations/*_security). Tables live in schema "app" (not exposed by Supabase's Data API).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime role: app_runtime (no BYPASSRLS)
  directUrl = env("DIRECT_URL") // owner role: migrations only
}

// ── Identity ────────────────────────────────────────────────────────

model User {
  id                String          @id @default(uuid(7)) @db.Uuid
  name              String?
  email             String?         @unique
  phone             String?         @unique
  totpSecretEnc     String?         @map("totp_secret_enc")
  totpEnabledAt     DateTime?       @map("totp_enabled_at") @db.Timestamptz(3)
  recoveryCodes     String[]        @default([]) @map("recovery_codes") // SHA-256 hashes
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions          Session[]
  memberships       Membership[]
  consents          ConsentRecord[]

  @@map("users")
}

model OtpChallenge {
  id          String    @id @default(uuid(7)) @db.Uuid
  channel     String // email | sms
  identifier  String // normalised email or E.164 phone
  codeHash    String    @map("code_hash")
  name        String?
  consent     Boolean   @default(false)
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@map("otp_challenges")
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified  Boolean   @default(false) @map("mfa_verified")
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model ConsentRecord {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String // e.g. privacy_notice
  version    String
  granted    Boolean
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("consent_records")
}

model DataSubjectRequest {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  kind        String // export | deletion
  status      String    @default("open")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3)

  @@map("data_subject_requests")
}

// ── Tenancy ─────────────────────────────────────────────────────────

model Firm {
  id             String           @id @default(uuid(7)) @db.Uuid
  name           String
  createdBy      String           @map("created_by") @db.Uuid
  connectCode    String           @unique @map("connect_code") // clients enter this to give the firm access
  perClientPrice Int              @default(4000) @map("per_client_price") // Naira / client / month (E6-4)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  members        FirmMember[]
  invitations    FirmInvitation[]
  workspaces     Workspace[]

  @@map("firms")
}

model FirmMember {
  firmId    String   @map("firm_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("accountant") // admin | accountant
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@id([firmId, userId])
  @@index([userId])
  @@map("firm_members")
}

model FirmInvitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  firmId     String    @map("firm_id") @db.Uuid
  firm       Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  email      String
  role       String
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([firmId])
  @@map("firm_invitations")
}

model Workspace {
  id                  String       @id @db.Uuid // generated by the API so RLS context can be set before insert
  firmId              String?      @map("firm_id") @db.Uuid
  firm                Firm?        @relation(fields: [firmId], references: [id])
  legalName           String       @map("legal_name")
  tradingName         String?      @map("trading_name")
  tin                 String
  tinVerifiedAt       DateTime?    @map("tin_verified_at") @db.Timestamptz(3)
  registryName        String?      @map("registry_name")
  address             String?
  email               String?
  phone               String?
  turnover            Decimal?     @db.Decimal(18, 2)
  logo                Bytes?
  logoMime            String?      @map("logo_mime")
  brandColor          String?      @map("brand_color")
  bankName            String?      @map("bank_name")
  bankAccountEnc      String?      @map("bank_account_enc") // AES-256-GCM
  bankAccountLast4    String?      @map("bank_account_last4")
  bankAccountName     String?      @map("bank_account_name")
  invoiceTerms        String?      @map("invoice_terms")
  invoicePrefix       String       @default("INV") @map("invoice_prefix")
  seqInvoice          Int          @default(0) @map("seq_invoice")
  seqCredit           Int          @default(0) @map("seq_credit")
  seqDebit            Int          @default(0) @map("seq_debit")
  mbsStatus           String       @default("not_connected") @map("mbs_status") // not_connected | sandbox | sandbox_passed | live
  mbsTestIrn          String?      @map("mbs_test_irn")
  mbsLiveAt           DateTime?    @map("mbs_live_at") @db.Timestamptz(3)
  approvalRequired    Boolean      @default(false) @map("approval_required")
  require2fa          Boolean      @default(false) @map("require_2fa")
  b2cEnabled          Boolean      @default(false) @map("b2c_enabled")
  firmLinkedAt        DateTime?    @map("firm_linked_at") @db.Timestamptz(3)
  plan                String       @default("trial") // trial | starter | business | pro
  trialEndsAt         DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  billingInterval     String?      @map("billing_interval") // monthly | yearly
  currentPeriodEnd    DateTime?    @map("current_period_end") @db.Timestamptz(3)
  autoRenew           Boolean      @default(true) @map("auto_renew")
  nextPlan            String?      @map("next_plan") // downgrade scheduled for renewal
  nextInterval        String?      @map("next_interval")
  billingEmail        String?      @map("billing_email")
  cardAuthEnc         String?      @map("card_auth_enc") // AES-256-GCM Paystack authorization code
  cardLast4           String?      @map("card_last4")
  cardBrand           String?      @map("card_brand")
  cardExpiry          String?      @map("card_expiry") // MM/YY
  approvalThreshold   Decimal?     @map("approval_threshold") @db.Decimal(18, 2)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships         Membership[]
  invitations         Invitation[]
  customers           Customer[]
  products            Product[]
  invoices            Invoice[]
  b2cReports          B2cReport[]
  vatDeclarations     VatDeclaration[]
  payments            Payment[]

  @@index([firmId])
  @@map("workspaces")
}

model Membership {
  workspaceId  String    @map("workspace_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         String
  tokenHash    String    @unique @map("token_hash")
  invitedBy    String    @map("invited_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workspaceId])
  @@map("invitations")
}

// ── Records ─────────────────────────────────────────────────────────

model Customer {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  kind         String    @default("B2B") // B2B | B2G
  tin          String
  registryName String?   @map("registry_name")
  email        String?
  phone        String?
  address      String?
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  invoices     Invoice[]

  @@index([workspaceId, tin])
  @@index([workspaceId, name])
  @@map("customers")
}

model Product {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sku           String?
  unitPrice     Decimal   @map("unit_price") @db.Decimal(18, 2)
  vatTreatment  String    @map("vat_treatment") // standard | zero | exempt
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workspaceId, name])
  @@map("products")
}

model ImportJob {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  kind         String // customers | products
  fileName     String   @map("file_name")
  headers      String[]
  rows         Json // string[][] — at most 5,000 rows
  status       String   @default("uploaded") // uploaded | completed
  result       Json?
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workspaceId])
  @@map("import_jobs")
}

// ── Invoicing & clearance ───────────────────────────────────────────

model Invoice {
  id                 String             @id @default(uuid(7)) @db.Uuid
  workspaceId        String             @map("workspace_id") @db.Uuid
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  docType            String             @default("invoice") @map("doc_type")
  number             String?
  status             String             @default("draft")
  customerId         String?            @map("customer_id") @db.Uuid
  customer           Customer?          @relation(fields: [customerId], references: [id])
  buyerSnapshot      Json?              @map("buyer_snapshot") // frozen at submission
  sellerSnapshot     Json?              @map("seller_snapshot")
  originalInvoiceId  String?            @map("original_invoice_id") @db.Uuid
  originalInvoice    Invoice?           @relation("Adjustments", fields: [originalInvoiceId], references: [id])
  adjustments        Invoice[]          @relation("Adjustments")
  reason             String?
  issueDate          DateTime           @map("issue_date") @db.Date
  dueDate            DateTime?          @map("due_date") @db.Date
  notes              String?
  subtotal           Decimal            @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal            @default(0) @map("discount_total") @db.Decimal(18, 2)
  vatTotal           Decimal            @default(0) @map("vat_total") @db.Decimal(18, 2)
  total              Decimal            @default(0) @db.Decimal(18, 2)
  irn                String?            @unique
  qrPayload          String?            @map("qr_payload")
  clearedAt          DateTime?          @map("cleared_at") @db.Timestamptz(3)
  paidAt             DateTime?          @map("paid_at") @db.Timestamptz(3) // E7-3; the only field that may change after clearance
  idempotencyKey     String?            @unique @map("idempotency_key")
  attempts           Int                @default(0)
  firstAttemptAt     DateTime?          @map("first_attempt_at") @db.Timestamptz(3)
  nextAttemptAt      DateTime?          @map("next_attempt_at") @db.Timestamptz(3)
  lastErrors         Json?              @map("last_errors") // [{code, field, message}]
  createdBy          String             @map("created_by") @db.Uuid
  approvedBy         String?            @map("approved_by") @db.Uuid
  submittedBy        String?            @map("submitted_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines              InvoiceLine[]
  attemptsLog        ClearanceAttempt[]
  shareLinks         ShareLink[]

  @@unique([workspaceId, docType, number])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position      Int
  productId     String?  @map("product_id") @db.Uuid
  description   String
  quantity      Decimal  @db.Decimal(18, 4)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(18, 2)
  discount      Decimal  @default(0) @db.Decimal(18, 2)
  vatTreatment  String   @map("vat_treatment")
  vatRate       Decimal  @map("vat_rate") @db.Decimal(6, 4)
  net           Decimal  @db.Decimal(18, 2)
  vat           Decimal  @db.Decimal(18, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model ClearanceAttempt {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  attempt      Int
  outcome      String // cleared | rejected | unavailable | error
  requestHash  String   @map("request_hash") // SHA-256 of the UBL document sent
  response     Json?
  durationMs   Int      @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([invoiceId])
  @@map("clearance_attempts")
}

model ShareLink {
  id           String       @id @default(uuid(7)) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  invoiceId    String       @map("invoice_id") @db.Uuid
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tokenHash    String       @unique @map("token_hash")
  channel      String
  recipient    String?
  createdBy    String       @map("created_by") @db.Uuid
  expiresAt    DateTime?    @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  events       ShareEvent[]

  @@index([invoiceId])
  @@map("share_links")
}

model ShareEvent {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  shareLinkId  String    @map("share_link_id") @db.Uuid
  shareLink    ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  event        String // sent | viewed | downloaded
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([shareLinkId])
  @@map("share_events")
}

// ── Reconciliation (E7) ─────────────────────────────────────────────

model VatDeclaration {
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  month        String // YYYY-MM
  declaredVat  Decimal   @map("declared_vat") @db.Decimal(18, 2) // output VAT the business filed for the month
  note         String?
  declaredBy   String    @map("declared_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([workspaceId, month])
  @@map("vat_declarations")
}

// ── B2C reporting (E5) ──────────────────────────────────────────────

model B2cReport {
  id           String     @id @default(uuid(7)) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  salesDate    DateTime   @map("sales_date") @db.Date
  status       String     @default("pending") // pending | submitting | accepted | rejected | failed
  noSales      Boolean    @default(false) @map("no_sales")
  rowCount     Int        @default(0) @map("row_count")
  netTotal     Decimal    @default(0) @map("net_total") @db.Decimal(18, 2)
  vatTotal     Decimal    @default(0) @map("vat_total") @db.Decimal(18, 2)
  grossTotal   Decimal    @default(0) @map("gross_total") @db.Decimal(18, 2)
  deadlineAt   DateTime   @map("deadline_at") @db.Timestamptz(3)
  reportRef    String?    @map("report_ref")
  attempts     Int        @default(0)
  lastErrors   Json?      @map("last_errors")
  submittedAt  DateTime?  @map("submitted_at") @db.Timestamptz(3)
  acceptedAt   DateTime?  @map("accepted_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales        B2cSale[]

  @@unique([workspaceId, salesDate])
  @@map("b2c_reports")
}

model B2cSale {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  reportId      String    @map("report_id") @db.Uuid
  report        B2cReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  receiptNo     String    @map("receipt_no")
  description   String?
  grossAmount   Decimal   @map("gross_amount") @db.Decimal(18, 2) // VAT-inclusive, as POS systems record it
  vatTreatment  String    @map("vat_treatment")
  net           Decimal   @db.Decimal(18, 2)
  vat           Decimal   @db.Decimal(18, 2)
  buyerName     String?   @map("buyer_name")
  buyerPhone    String?   @map("buyer_phone")

  @@unique([reportId, receiptNo])
  @@map("b2c_sales")
}

// ── Platform ────────────────────────────────────────────────────────

model AuditEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid // null = system
  actorName    String?  @map("actor_name")
  entity       String
  entityId     String?  @map("entity_id")
  action       String
  detail       Json?
  ip           String?
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entity, entityId])
  @@map("audit_events")
}

model Job {
  id           String    @id @default(uuid(7)) @db.Uuid
  type         String
  workspaceId  String?   @map("workspace_id") @db.Uuid
  payload      Json
  status       String    @default("pending") // pending | running | done | dead
  runAt        DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(3)
  lastError    String?   @map("last_error")
  dedupeKey    String?   @unique @map("dedupe_key")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, runAt])
  @@map("jobs")
}

model OutboxMessage {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String?   @map("workspace_id") @db.Uuid
  channel      String // email | sms | whatsapp
  recipient    String
  subject      String?
  body         String
  status       String    @default("pending") // pending | sent | failed
  attempts     Int       @default(0)
  providerRef  String?   @map("provider_ref")
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status])
  @@map("outbox_messages")
}

model RateLimitBucket {
  key          String
  windowStart  DateTime @map("window_start") @db.Timestamptz(3)
  count        Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit_buckets")
}

// ── Mock MBS (sandbox stand-in for NRS; never used once a real APP adapter is configured) ──

model MockMbsDocument {
  irn             String   @id
  idempotencyKey  String   @unique @map("idempotency_key")
  sellerTin       String   @map("seller_tin")
  buyerTin        String?  @map("buyer_tin")
  docType         String   @map("doc_type")
  total           Decimal  @db.Decimal(18, 2)
  issueDate       String   @map("issue_date")
  sandbox         Boolean
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("mock_mbs_documents")
}

/// E10-2: one attempt to pay for a plan period (checkout or automatic renewal).
model Payment {
  id            String    @id @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  reference     String    @unique
  kind          String // checkout | renewal
  plan          String
  interval      String
  amount        Int // kobo actually charged
  listPrice     Int       @map("list_price") // kobo
  credit        Int       @default(0) // kobo of proration credit applied
  status        String    @default("pending") // pending | success | failed | abandoned | refund_pending | refunded | refund_failed
  authorizationUrl String? @map("authorization_url")
  channel       String?
  failureReason String?   @map("failure_reason")
  periodStart   DateTime? @map("period_start") @db.Timestamptz(3)
  periodEnd     DateTime? @map("period_end") @db.Timestamptz(3)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(3)
  receiptNumber String?   @unique @map("receipt_number")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Reconciliation findings that need a person (written by app.record_payment_discrepancy).
model PaymentDiscrepancy {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  detectedAt  DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  reference   String
  workspaceId String?   @map("workspace_id") @db.Uuid
  kind        String
  detail      Json?
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@unique([reference, kind])
  @@map("payment_discrepancies")
}
